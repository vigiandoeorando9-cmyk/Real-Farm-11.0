{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe producer profile visible to room peers and owned by the user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Producer display name.",
          "minLength": 2,
          "maxLength": 48
        },
        "avatarStyle": {
          "type": "string",
          "description": "Hat/avatar badge style.",
          "enum": ["palha", "bone", "vaqueiro", "sem"]
        },
        "activePlatform": {
          "type": "string",
          "description": "Last active platform.",
          "enum": ["DESKTOP_PC", "MOBILE", "TABLET", "WEB"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "displayName", "avatarStyle", "activePlatform", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Owner-only PII record storing account email and sync preferences.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "preferredRegion": {
          "type": "string",
          "maxLength": 48
        },
        "mobileStorageLimitMb": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "mobileStorageLimitMb", "createdAt", "updatedAt"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Registered physical device authorized under the producer account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "enum": ["DESKTOP_PC", "CELULAR", "EQUILIBRADO"]
        },
        "graphicsPreset": {
          "type": "string",
          "maxLength": 32
        },
        "appVersion": {
          "type": "string",
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "deviceId", "deviceName", "platform", "appVersion", "createdAt", "updatedAt"]
    },
    "CloudSave": {
      "title": "CloudSave",
      "description": "Compact cross-device cloud save document synchronized under FARM BRASIL CLOUD.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slotIndex": {
          "type": "number"
        },
        "farmName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mapId": {
          "type": "string",
          "maxLength": 64
        },
        "mapGridSize": {
          "type": "number"
        },
        "startingMode": {
          "type": "string",
          "maxLength": 48
        },
        "day": {
          "type": "number"
        },
        "month": {
          "type": "number"
        },
        "hourOfDay": {
          "type": "number"
        },
        "weather": {
          "type": "string",
          "maxLength": 32
        },
        "moneyBrl": {
          "type": "number"
        },
        "bankLoanBrl": {
          "type": "number"
        },
        "revision": {
          "type": "number"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "maxLength": 64
        },
        "checksumSha256": {
          "type": "string",
          "maxLength": 128
        },
        "requiredModIds": {
          "type": "array"
        },
        "payloadSizeBytes": {
          "type": "number"
        },
        "compactCellsRle": {
          "type": "string",
          "maxLength": 450000
        },
        "playerMap": {
          "type": "object"
        },
        "plotsList": {
          "type": "array"
        },
        "vehiclesList": {
          "type": "array"
        },
        "implementsList": {
          "type": "array"
        },
        "buildingsList": {
          "type": "array"
        },
        "industriesList": {
          "type": "array"
        },
        "herdsList": {
          "type": "array"
        },
        "inventoryMap": {
          "type": "object"
        },
        "contractsList": {
          "type": "array"
        },
        "activeVehicleUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "slotIndex",
        "farmName",
        "mapId",
        "mapGridSize",
        "startingMode",
        "day",
        "month",
        "hourOfDay",
        "weather",
        "moneyBrl",
        "bankLoanBrl",
        "revision",
        "deviceId",
        "deviceName",
        "checksumSha256",
        "requiredModIds",
        "payloadSizeBytes",
        "compactCellsRle",
        "playerMap",
        "plotsList",
        "vehiclesList",
        "implementsList",
        "buildingsList",
        "industriesList",
        "herdsList",
        "inventoryMap",
        "contractsList",
        "createdAt",
        "updatedAt"
      ]
    },
    "MultiplayerRoom": {
      "title": "MultiplayerRoom",
      "description": "Online multiplayer room header hosted by a verified Farm Brasil producer.",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48
        },
        "mapId": {
          "type": "string",
          "maxLength": 64
        },
        "gameVersion": {
          "type": "string",
          "maxLength": 24
        },
        "sharedFarmMode": {
          "type": "boolean"
        },
        "pauseOnDisconnect": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["WAITING", "ACTIVE", "CLOSED"]
        },
        "requiredModIds": {
          "type": "array"
        },
        "memberCount": {
          "type": "number"
        },
        "maxPlayers": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomCode",
        "hostUid",
        "hostName",
        "mapId",
        "gameVersion",
        "sharedFarmMode",
        "pauseOnDisconnect",
        "status",
        "requiredModIds",
        "memberCount",
        "maxPlayers",
        "createdAt",
        "updatedAt"
      ]
    },
    "MultiplayerRoomMember": {
      "title": "MultiplayerRoomMember",
      "description": "Connected participant telemetry and authorization state inside a multiplayer room.",
      "type": "object",
      "properties": {
        "memberUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48
        },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "vehicleDefId": {
          "type": "string",
          "maxLength": 64
        },
        "headingDeg": { "type": "number" },
        "pitchDeg": { "type": "number" },
        "rollDeg": { "type": "number" },
        "steerAngleDeg": { "type": "number" },
        "wheelSpinDeg": { "type": "number" },
        "suspensionOffsetY": { "type": "number" },
        "isApproved": { "type": "boolean" },
        "role": {
          "type": "string",
          "enum": ["HOST", "OPERATOR", "GUEST"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "memberUid",
        "roomCode",
        "playerName",
        "x",
        "z",
        "headingDeg",
        "isApproved",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "MultiplayerRoomChat": {
      "title": "MultiplayerRoomChat",
      "description": "Real-time text message inside an active online multiplayer room.",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48
        },
        "roomCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderUid", "senderName", "roomCode", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public-safe producer display profile owned strictly by userId."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Owner-only PII record containing email and sync limits."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/UserDevice" },
      "description": "Registered physical devices linked to the producer account."
    },
    "/users/{userId}/cloudSaves/{slotId}": {
      "schema": { "$ref": "#/entities/CloudSave" },
      "description": "Cross-device Farm Brasil Cloud save slots."
    },
    "/mpRooms/{roomCode}": {
      "schema": { "$ref": "#/entities/MultiplayerRoom" },
      "description": "Active online multiplayer rooms."
    },
    "/mpRooms/{roomCode}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/MultiplayerRoomMember" },
      "description": "Telemetry and permissions for members in a multiplayer room."
    },
    "/mpRooms/{roomCode}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MultiplayerRoomChat" },
      "description": "Chat messages inside a multiplayer room."
    }
  }
}
